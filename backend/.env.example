# MongoDB connection. Use an Atlas SRV URI or a local mongod.
#   Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   Local:  mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=graphene_benchmarker

# JWT signing. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Raw spectra file storage. "local" writes under STORAGE_LOCAL_DIR; "s3" uses the
# S3_* settings below (any S3-compatible endpoint: AWS, R2, MinIO).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_BYTES=26214400
